{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Joycon Studio",
  "version": "6.0.0",
  "identifier": "app.joyconstudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5299",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Joycon Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
